{
  "name": "media-planner-v2",
  "version": "3.0.0",
  "description": "Media Planner Desktop Application",
  "main": "electron/main.js",
  "private": true,
  "type": "module",
  "scripts": {
    "server": "node server/index.js",
    "frontend": "npm --prefix frontend run dev",
    "dev": "concurrently -n \"SERVER,FRONTEND\" -c \"blue,green\" \"npm run server\" \"npm run frontend\"",
    "build": "npm --prefix frontend run build",
    "electron:dev": "concurrently -n \"SERVER,FRONTEND,ELECTRON\" -c \"blue,green,magenta\" \"npm run server\" \"npm run frontend\" \"wait-on http://localhost:5173 && electron . --dev\"",
    "electron:build": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.mediaplanner.app",
    "productName": "Media Planner",
    "directories": {
      "output": "release"
    },
    "files": [
      "server/**/*",
      "frontend/dist/**/*",
      "electron/**/*",
      "package.json",
      "logo.ico"
    ],
    "win": {
      "icon": "logo.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Media Planner v2"
    },
    "publish": {
      "provider": "github",
      "owner": "minikkerata",
      "repo": "media_planner"
    }
  },
  "dependencies": {
    "cors": "^2.8.5",
    "electron-updater": "^6.2.1",
    "express": "^4.19.2",
    "ffmpeg-static": "^5.2.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^29.3.0",
    "electron-builder": "^24.13.3",
    "wait-on": "^7.2.0"
  }
}
